# Kubernetes Secrets Template for MathWizz
#
# WARNING: Do NOT commit actual secrets to git!
# This template shows the structure of secrets.yaml
#
# To use this template:
# 1. Copy this file: cp secrets.yaml.template secrets.yaml
# 2. Replace PLACEHOLDER values with your actual secrets
# 3. Base64 encode your secrets: echo -n 'your-password' | base64
# 4. Paste the base64-encoded values below
# 5. Apply to cluster: kubectl apply -f secrets.yaml
#
# The secrets.yaml file is gitignored to prevent accidental commits
#
# For production environments, use proper secret management:
# - Sealed Secrets: https://github.com/bitnami-labs/sealed-secrets
# - External Secrets Operator: https://external-secrets.io/
# - HashiCorp Vault: https://www.vaultproject.io/
# - Cloud provider secret managers (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault)

apiVersion: v1
kind: Secret
metadata:
  name: mathwizz-secrets
  namespace: mathwizz
type: Opaque
data:
  # Database password for the application (base64 encoded)
  # Replace PLACEHOLDER_DB_PASSWORD with: echo -n 'your-db-password' | base64
  DB_PASSWORD: PLACEHOLDER_DB_PASSWORD

  # PostgreSQL admin password (base64 encoded)
  # Replace PLACEHOLDER_POSTGRES_PASSWORD with: echo -n 'your-postgres-password' | base64
  POSTGRES_PASSWORD: PLACEHOLDER_POSTGRES_PASSWORD

  # JWT secret for token generation (base64 encoded)
  # Replace PLACEHOLDER_JWT_SECRET with: echo -n 'your-jwt-secret-at-least-32-chars' | base64
  JWT_SECRET: PLACEHOLDER_JWT_SECRET
